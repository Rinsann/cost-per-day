{
  "expo": {
    "name": "算得值",
    "slug": "cost-per-day",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "costperday",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#3DD9AC"
      },
      "package": "com.rinsann.costperday"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#08080F",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#08080F"
          },
          "android": {
            "image": "./assets/brand/splash-icon.png",
            "imageWidth": 160,
            "resizeMode": "contain",
            "backgroundColor": "#08080F"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92600c0b-92a2-49d3-ad49-dfbae8e2f4ae"
      }
    },
    "owner": "rinsanv"
  }
}
